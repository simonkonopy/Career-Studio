# Copy to .env locally. Never commit real credentials.
PORT=4174
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4174
NODE_ENV=development
DATA_DIR=./data
# Hosted API mode only. The customer never supplies this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
AI_DAILY_LIMIT=40
AI_GLOBAL_DAILY_LIMIT=400
AI_CONCURRENCY=3
# Required in production; share privately with your invited pilot users.
PILOT_INVITE_CODE=
# Exact IPs of your HTTPS reverse proxy. Required in production.
# The proxy must overwrite X-Forwarded-For with one client IP; restrict direct app access.
TRUSTED_PROXY_IPS=
# Experimental Mac-only local companion; never enable on a hosted server.
# Uses official, separate ChatGPT sign-in; does not reuse an API key.
LOCAL_COMPANION=0
# Optional absolute path to the tested official Codex 0.153.4 binary.
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
