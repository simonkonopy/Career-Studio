{
  "schemaVersion": 1,
  "name": "Career Studio design reference",
  "updated": "2026-09-09",
  "purpose": "Document the implemented customer UI and the Fable deck v3 visual system for the next engineer. This file is a reference; application CSS remains the runtime source of truth.",
  "sources": {
    "ui": "public/app.css",
    "documentHead": "public/index.html",
    "deck": "Fable deck v3 DESIGN_SPEC.md"
  },
  "ui": {
    "theme": "blue light interface",
    "colorScheme": "light",
    "colors": {
      "ink": "#172538",
      "muted": "#5c6b7f",
      "accent": "#1f5fd0",
      "accentDark": "#174aa6",
      "tint": "#e6eefc",
      "paper": "#ffffff",
      "canvas": "#f4f7fb",
      "line": "#d8e1ee",
      "danger": "#a63a35",
      "warm": "#f5efe1",
      "sidebar": "#eef3fa",
      "navActiveBackground": "#dbe6fa",
      "navActiveForeground": "#174aa6",
      "focusRing": "#8fb3f2",
      "saveState": {
        "saved": "#2f9e5f",
        "dirty": "#d9a441",
        "saving": "#8fb3f2",
        "error": "#a63a35",
        "conflict": "#a63a35"
      },
      "skillChips": {
        "independent": {
          "background": "#e6efe4",
          "text": "#315b35"
        },
        "assisted": {
          "background": "#dfe9fb",
          "text": "#1e4ea8"
        },
        "learning": {
          "background": "#f5edda",
          "text": "#826228"
        }
      },
      "documentInk": "#1f2a38"
    },
    "typography": {
      "body": {
        "cssFontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
        "fontSize": "15px",
        "lineHeight": 1.55
      },
      "h1": {
        "fontFamily": "inherit",
        "fontSize": "clamp(29px, 3vw, 40px)",
        "lineHeight": 1.15,
        "fontWeight": 650,
        "letterSpacing": "-1.2px"
      },
      "h2": {
        "fontFamily": "inherit",
        "fontSize": "22px",
        "lineHeight": 1.25,
        "letterSpacing": "-0.5px"
      },
      "h3": {
        "fontFamily": "inherit",
        "fontSize": "17px",
        "lineHeight": 1.35
      },
      "button": {
        "fontFamily": "inherit",
        "fontSize": "13px",
        "lineHeight": 1.4,
        "fontWeight": 650
      },
      "welcomeHeading": {
        "selector": ".welcome h2",
        "fontFamily": "Georgia, serif",
        "fontSize": "29px",
        "lineHeight": 1.22,
        "fontWeight": 400
      },
      "authStoryHeading": {
        "selector": ".auth-story h1",
        "fontFamily": "Georgia, serif",
        "fontSize": "clamp(42px, 4vw, 58px)",
        "lineHeight": 1.07,
        "fontWeight": 400,
        "letterSpacing": "-1.8px"
      },
      "brandMark": {
        "selector": ".brand-mark",
        "fontFamily": "Georgia, serif",
        "fontSize": "25px",
        "fontStyle": "italic"
      },
      "coachMark": {
        "selector": ".coach-avatar",
        "fontFamily": "Georgia, serif",
        "fontSize": "22px",
        "fontStyle": "italic"
      },
      "resumeDocument": {
        "selector": ".resume-document",
        "fontFamily": "Georgia, serif",
        "fontSize": "13px",
        "lineHeight": 1.55
      },
      "printedResume": {
        "selector": ".print-area",
        "fontFamily": "Georgia, serif",
        "fontSize": "11pt",
        "lineHeight": 1.45
      },
      "notes": [
        "Controls inherit the system font. Serif type is limited to the welcome/sign-in story headings, C marks, and resume document/print surfaces.",
        "Selector-specific sizes such as chat headers and record headings remain in public/app.css."
      ]
    },
    "layout": {
      "boxSizing": "border-box",
      "shell": {
        "display": "grid",
        "gridTemplateColumns": "236px 1fr",
        "minHeight": "100vh"
      },
      "sidebar": {
        "position": "sticky",
        "top": "0",
        "height": "100vh",
        "padding": "29px 22px 22px"
      },
      "content": {
        "maxWidth": "1320px",
        "padding": "39px 42px 64px",
        "margin": "auto"
      },
      "topbar": {
        "padding": "19px 42px",
        "minHeight": "69px"
      },
      "columns": {
        "gridTemplateColumns": "minmax(0, 1.6fr) minmax(260px, 1fr)",
        "gap": "22px"
      },
      "interviewColumns": {
        "gridTemplateColumns": "minmax(0, 1.5fr) minmax(290px, 1fr)",
        "gap": "22px"
      },
      "stats": {
        "gridTemplateColumns": "repeat(4, 1fr)",
        "gap": "16px"
      },
      "card": {
        "padding": "25px",
        "border": "1px solid #d8e1ee",
        "borderRadius": "13px"
      },
      "button": {
        "padding": "10px 17px",
        "minHeight": "40px",
        "borderRadius": "8px"
      },
      "skillRow": {
        "gridTemplateColumns": "minmax(0, 1fr) 190px",
        "gap": "15px"
      },
      "customTaskForm": {
        "gridTemplateColumns": "minmax(0, 1fr) 190px auto",
        "gap": "12px",
        "padding": "16px"
      },
      "documentShadow": "0 14px 40px #1b3a6b12"
    },
    "responsive": [
      {
        "query": "(min-width: 1500px)",
        "changes": {
          "shellColumns": "252px 1fr",
          "contentPaddingTop": "46px",
          "sidebarPaddingLeft": "27px",
          "sidebarPaddingRight": "27px"
        }
      },
      {
        "query": "(max-width: 1100px)",
        "changes": {
          "shellColumns": "200px 1fr",
          "sidebarPadding": "25px 15px",
          "contentPadding": "30px 25px 50px",
          "topbarPadding": "18px 25px",
          "columns": "1fr",
          "interviewColumns": "1fr",
          "statNumberFontSize": "25px",
          "demoBannerPadding": "14px 25px"
        }
      },
      {
        "query": "(max-width: 750px)",
        "changes": {
          "shellDisplay": "block",
          "sidebarPosition": "relative",
          "sidebarHeight": "auto",
          "sidebarPadding": "14px 18px 0",
          "navDisplay": "flex",
          "navOverflow": "auto",
          "navActiveRailDisplay": "none",
          "accountLabelDisplay": "none",
          "accountChevronDisplay": "none",
          "sidebarAccountPadding": "0",
          "contentPadding": "27px 20px 45px",
          "topbarPadding": "13px 20px",
          "topbarMinHeight": "49px",
          "statsColumns": "1fr 1fr",
          "statsGap": "11px",
          "statNumberFontSize": "26px",
          "cardPadding": "21px",
          "pageHeadingFontSize": "29px",
          "pageDescriptionFontSize": "13px",
          "welcomeHeadingFontSize": "27px",
          "authStoryHeadingFontSize": "37px",
          "authStoryHeadingLetterSpacing": "-1px",
          "authBoxHeadingFontSize": "26px",
          "cardHeadH2FontSize": "20px",
          "skillRowColumns": "minmax(0, 1fr) 142px",
          "skillRowGap": "10px",
          "skillSelectFontSize": "11px",
          "customTaskFormColumns": "minmax(0, 1fr)",
          "customTaskFormPadding": "12px",
          "interviewSkillChooserColumns": "minmax(0, 1fr)",
          "formColumns": "1fr",
          "activityColumns": "1fr",
          "applicationColumns": "1fr",
          "authPageDisplay": "block",
          "resumePadding": "23px",
          "formFooterDirection": "column"
        }
      }
    ],
    "interaction": {
      "transition": "background-color .15s, border-color .15s, color .15s, box-shadow .15s",
      "focus": {
        "defaultOutline": "3px solid #8fb3f2",
        "defaultOffset": "3px",
        "buttonAndNavOffset": "2px"
      },
      "navigation": "Active desktop navigation has a 3px accent rail. Mobile keeps the active background/text and hides the rail.",
      "statLinks": "Clickable stat cards retain the blue Open link treatment; the later .stat-link rule overrides the earlier .stat span muted color.",
      "saveState": "Color is accompanied by a text label for saved, unsaved, saving, failed and conflicting changes.",
      "skillLevels": "Independent, assisted, learning and not-yet-done are explicit customer choices. Color must not replace the text distinction.",
      "pendingTask": "Over-limit task choices remain visibly unsaved and offer a retry after space is available.",
      "demo": "The shared interface always displays the fictional-data/simulated-AI/reset notice in demo mode."
    },
    "accessibilityAndPrint": {
      "reducedMotionQuery": "(prefers-reduced-motion: reduce)",
      "reducedMotion": {
        "scrollBehavior": "auto !important",
        "transition": "none !important"
      },
      "skipLink": "Hidden off-screen until focused; points to the main content.",
      "print": {
        "pageMargin": "0.65in",
        "onlySurface": ".print-area",
        "color": "#000000",
        "background": "#ffffff",
        "whiteSpace": "pre-wrap"
      },
      "notes": [
        "The horizontal navigation is intentionally scrollable on small screens. The page itself must not overflow horizontally.",
        "Reduced-motion and visible focus behavior must survive theme refactors."
      ]
    },
    "verification": {
      "method": "Read CSS including later overrides and inspected computed styles in the local fictional demo.",
      "viewportWidthsPx": [
        390,
        1000,
        1440,
        1600
      ],
      "observedMainHeadingSizesPx": {
        "390": 29,
        "1000": 30,
        "1440": 40,
        "1600": 40
      },
      "observedSidebarWidthsPx": {
        "1000": 200,
        "1440": 236,
        "1600": 252
      },
      "note": "At 750px and below the shell uses block layout; a computed grid-template-columns value is inactive and must not be interpreted as a visible sidebar width."
    }
  },
  "deck": {
    "system": "Fable deck v3; carried forward in the current 29-slide handoff",
    "format": {
      "aspectRatio": "16:9",
      "widthIn": 13.333,
      "heightIn": 7.5
    },
    "typography": {
      "fontFamily": "Helvetica Neue",
      "fallback": "Arial",
      "titlePt": 30,
      "takeawayPt": 15,
      "kickerPt": 11,
      "bodyPt": [
        14,
        16
      ],
      "minimumBodyPt": 13,
      "minimumTextPt": 9,
      "footerPt": 9,
      "coverTitlePt": 44
    },
    "palette": {
      "navy": "#0b2545",
      "ink": "#171717",
      "slate": "#52677f",
      "line": "#c9d6e8",
      "tint": "#f3f6fb",
      "paper": "#ffffff",
      "part1Product": "#1f7a5a",
      "part2BuildAndRun": "#175cd4",
      "part3PilotAndSell": "#c2410c",
      "warningBackground": "#fdecec",
      "warningText": "#b42318"
    },
    "grid": {
      "marginLeftRightIn": 0.6,
      "contentTopIn": 1.55,
      "contentBottomIn": 6.7,
      "footerTopIn": 6.95,
      "footerBottomIn": 7.2,
      "cardGutterIn": 0.25,
      "cardPaddingIn": 0.22,
      "cardCornerRadiusApproxIn": 0.08
    },
    "structure": [
      "Part kicker",
      "Audience chip",
      "Title",
      "Takeaway and rule",
      "Cards or native block diagram",
      "Footer and slide number"
    ],
    "diagramRules": {
      "nativeEditableShapes": true,
      "minimumBlockWidthIn": 1.4,
      "blockTextPt": [
        12,
        14
      ],
      "arrowLabelPt": [
        10,
        11
      ],
      "readingOrder": "left-to-right or top-to-bottom",
      "requireClearStartAndEnd": true
    },
    "notes": [
      "Part 1 green identifies the product section of the deck. It is not the current blue customer-interface accent.",
      "Use the current dated 29-slide deck for content. The old source specification contains an outdated 26-slide label and historical footer date.",
      "Screenshots must show fictional demo data and identify simulated AI; the current any-skill flow supersedes Excel-only descriptions."
    ]
  }
}
